<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/qa_bg"
    android:keepScreenOn="true">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/qa_bg"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/loading"
            android:textColor="@color/qa_text"
            android:textSize="28sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/remoteMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/menu_panel"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="遥控器菜单"
            android:textColor="@color/qa_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="320dp"
            android:layout_height="72dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/qa_accent"
            android:focusable="true"
            android:text="@string/menu_refresh"
            android:textSize="22sp" />

        <Button
            android:id="@+id/btnHardReload"
            android:layout_width="320dp"
            android:layout_height="72dp"
            android:backgroundTint="@color/qa_accent"
            android:focusable="true"
            android:text="@string/menu_reload_hard"
            android:textSize="22sp" />
    </LinearLayout>
</FrameLayout>
